<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.26-beta.27</Version><ApplicationIcon>Assets\cinevo.ico</ApplicationIcon>
    <AssemblyName>Cinevo</AssemblyName><Product>Cinevo</Product>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Web\*" />
    <EmbeddedResource Include="Assets\cinevo.ico" />
    <EmbeddedResource Include="Assets\cinevo.png" />
    <Resource Include="Assets\cinevo.ico" />
  </ItemGroup>
</Project>
