<Window x:Class="Cinevo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cinevo Beta — seu cinema, em casa" Background="#0D0F15" Foreground="#ECEEF4" FontFamily="Segoe UI" Width="1360" Height="900" MinWidth="1060" MinHeight="740" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#13151D" BorderBrush="#232631" BorderThickness="0,0,1,0" Padding="20,30,18,22"><DockPanel LastChildFill="False">
   <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><TextBlock Text="◒" Foreground="#B49AF8" FontSize="30"/><TextBlock Text="cinevo" FontSize="29" FontWeight="Bold" Margin="9,-3,0,0"/></StackPanel><TextBlock Text="SEU CINEMA, EM CASA" FontSize="9" Foreground="#777C90" Margin="2,12,0,36"/>
    <TextBlock Text="EXPLORAR" Foreground="#777C90" FontSize="10" Margin="12,0,0,12"/>
    <Button x:Name="NavAll" Content="▦   Minha biblioteca" Tag="all" Click="Filter_Click" Style="{StaticResource NavButton}"/>
    <Button x:Name="NavUnwatched" Content="▷   Para assistir" Tag="unwatched" Click="Filter_Click" Style="{StaticResource NavButton}"/>
    <Button x:Name="NavWatched" Content="✓   Assistidos" Tag="watched" Click="Filter_Click" Style="{StaticResource NavButton}"/>
    <Button x:Name="NavFavorites" Content="☆   Favoritos" Tag="favorites" Click="Filter_Click" Style="{StaticResource NavButton}"/>
    <TextBlock Text="SUA COLEÇÃO" Foreground="#777C90" FontSize="10" Margin="12,30,0,12"/>
    <Button Content="＋   Adicionar pastas" Click="AddFolder_Click" Style="{StaticResource NavButton}"/>
    <Button Content="▱   Gerenciar pastas" Click="Folders_Click" Style="{StaticResource NavButton}"/>
    <Button x:Name="ScanButton" Content="↻   Atualizar coleção" Click="Scan_Click" Style="{StaticResource NavButton}"/>
    <Button x:Name="CancelButton" Content="Cancelar busca" Click="Cancel_Click" Visibility="Collapsed" Margin="0,8,0,0"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Background="#1D1A2C" CornerRadius="10" Padding="13" Margin="0,0,0,18"><StackPanel><TextBlock Text="Feito para a sua sessão." Foreground="#CBBBF9" FontSize="11"/><TextBlock Text="Seus filmes. Seu espaço." Foreground="#8B819F" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border><Button Content="⚙   Configurações" Click="Settings_Click" Style="{StaticResource NavButton}"/><TextBlock x:Name="VersionLabel" Foreground="#A18FC9" FontSize="10" Text="Cinevo 0.1.1 · Beta" Margin="12,18,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="32,26,28,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22"><Button Content="＋  Adicionar filmes" Click="AddFolder_Click" DockPanel.Dock="Right" Background="#B49AF8" Foreground="#171121" Margin="12,5,0,0"/><StackPanel><TextBlock x:Name="PageTitle" Text="Minha biblioteca" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="Stats" Foreground="#858B9E" FontSize="12" Margin="0,6,0,0"/></StackPanel></DockPanel>
   <Border Grid.Row="1" CornerRadius="16" BorderBrush="#363045" BorderThickness="1" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#211C32"/><GradientStop Offset="0.65" Color="#191A28"/><GradientStop Offset="1" Color="#323044"/></LinearGradientBrush></Border.Background>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel Margin="26,20,18,16" VerticalAlignment="Center"><TextBlock Text="DÊ PLAY NO SEU MOMENTO" Foreground="#BBA5EC" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="HeroTitle" Text="Toda boa sessão começa aqui." FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,9,0,5"/><TextBlock x:Name="HeroMeta" Text="Organize sua coleção e assista sem sair do Cinevo." Foreground="#A6A3B5" FontSize="12" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,17,0,0"><Button x:Name="HeroPlayButton" Content="▶  Assistir agora" Click="Play_Click" Background="#B49AF8" Foreground="#16101F" Padding="18,9"/><Button x:Name="HeroDetailsButton" Content="Sobre o filme" Click="Details_Click" Background="#343043" Padding="18,9"/><Button x:Name="HeroAddButton" Content="＋  Começar minha coleção" Click="AddFolder_Click" Background="#B49AF8" Foreground="#16101F" Padding="18,9" Visibility="Collapsed"/></StackPanel></StackPanel>
     <Grid Grid.Column="1" Margin="0,12,28,12"><TextBlock Text="C" Foreground="#4B4166" FontSize="130" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="HeroCover" Stretch="Uniform" Source="{Binding Cover, Converter={StaticResource CoverImage}}"/></Grid>
    </Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,22,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid><TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="Buscar por título, ano, gênero ou arquivo" AutomationProperties.Name="Buscar filmes" VerticalContentAlignment="Center" Padding="15,11"/><TextBlock Text="⌕   Buscar na sua coleção…" Foreground="#777D90" Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <ComboBox x:Name="Sort" Grid.Column="1" Margin="12,0" Width="185" SelectedIndex="0" SelectionChanged="Sort_Changed"><ComboBoxItem Content="Título A–Z"/><ComboBoxItem Content="Adicionados recentemente"/><ComboBoxItem Content="Ano mais recente"/><ComboBoxItem Content="Melhor avaliação"/></ComboBox>
    <Button x:Name="CoversButton" Grid.Column="2" Content="↻  Buscar capas" Click="Covers_Click" ToolTip="Busca capas pelo título e ano na Wikipédia" Margin="0"/>
   </Grid>
   <Grid Grid.Row="3"><ListBox x:Name="MovieList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch" MouseDoubleClick="Movie_DoubleClick" KeyDown="Movie_KeyDown" SizeChanged="MovieList_SizeChanged">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Movies}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Border x:Name="Card" Background="#171A23" CornerRadius="11" BorderBrush="#292D3B" BorderThickness="1" Margin="0,0,14,0" Padding="0" ToolTip="{Binding Title}"><StackPanel>
      <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource PosterHeight}}" ClipToBounds="True" Background="#252235"><TextBlock Text="{Binding Initial}" FontSize="72" Foreground="#51456D" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Cover, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"/><Border Background="#BB11121B" CornerRadius="5" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9"><TextBlock Text="{Binding Badge}" Foreground="#E7DCF9" FontSize="9"/></Border><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="3" VerticalAlignment="Bottom" BorderThickness="0" Background="Transparent" Foreground="#B49AF8"/></Grid>
      <StackPanel Margin="11,11,11,12"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#E9E9F2" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,5,0,10"><TextBlock Text="{Binding Year}" Foreground="#888EA2" FontSize="11"/><TextBlock Text="{Binding State}" Foreground="#A899C3" FontSize="10" HorizontalAlignment="Right"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{Binding PlayLabel}" Click="Play_Click" Padding="8,8" Background="#30273F" Foreground="#DCCBFF" FontSize="11"/><Button Grid.Column="1" Content="•••" Click="Details_Click" ToolTip="Detalhes, capas e avaliação" Padding="10,8" Margin="0" Background="#252936"/></Grid></StackPanel>
     </StackPanel></Border><DataTemplate.Triggers><Trigger SourceName="Card" Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#A58AD9"/><Setter TargetName="Card" Property="Background" Value="#202330"/></Trigger></DataTemplate.Triggers>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430"><TextBlock Text="Sua coleção merece uma tela grande." FontSize="23" TextAlignment="Center"/><TextBlock x:Name="EmptyText" Text="Adicione uma pasta. Os pôsteres chegam depois, e os filmes continuam exatamente onde estão." Foreground="#858B9E" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,20"/><Button Content="＋  Adicionar pasta de filmes" Click="AddFolder_Click" HorizontalAlignment="Center" Background="#B49AF8" Foreground="#15111F"/></StackPanel>
   </Grid>
   <DockPanel Grid.Row="4" Margin="0,12,0,0"><Button x:Name="UpdateButton" Content="Instalar atualização" Click="Update_Click" Visibility="Collapsed" DockPanel.Dock="Right"/><TextBlock x:Name="Status" Text="Sua biblioteca, pronta para a próxima sessão." Foreground="#73798D" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  </Grid>
 </Grid>
</Window>
