<Window x:Class="Cinevo.PlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Cinevo" Title="Cinevo — player" Background="#090B10" Foreground="#ECEEF4" Width="1150" Height="760" MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner" PreviewKeyDown="Player_KeyDown">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel x:Name="Header" Margin="20,14"><Button Content="‹  Biblioteca" DockPanel.Dock="Left" Click="Back_Click"/><TextBlock x:Name="MovieTitle" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Margin="12,0" TextTrimming="CharacterEllipsis"/></DockPanel>
  <Grid Grid.Row="1" Background="Black"><local:VideoSurface x:Name="Video"/></Grid>
  <StackPanel Grid.Row="2" Margin="24,12,24,18"><TextBlock x:Name="PlayerStatus" Text="Preparando a sessão…" Foreground="#ABA6BC" FontSize="12" Margin="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Elapsed" Text="00:00" VerticalAlignment="Center" Margin="0,0,12,0"/><Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="Timeline_Changed" PreviewMouseLeftButtonDown="Seek_Start" PreviewMouseLeftButtonUp="Seek_End" AutomationProperties.Name="Posição do filme"/><TextBlock x:Name="Total" Grid.Column="2" Text="00:00" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
   <DockPanel Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="Volume" Width="90" Minimum="0" Maximum="100" Value="80" ValueChanged="Volume_Changed" VerticalAlignment="Center" AutomationProperties.Name="Volume"/><Button Content="⛶" ToolTip="Tela cheia (F)" Click="Fullscreen_Click" Margin="15,0,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal"><Button Content="−10s" Click="BackTen_Click"/><Button x:Name="PauseButton" Content="Ⅱ  Pausar" Click="Pause_Click" Background="#B49AF8" Foreground="#15111F"/><Button Content="+10s" Click="ForwardTen_Click"/><Button Content="Legenda…" Click="Subtitle_Click"/><ComboBox x:Name="AudioTracks" Width="130" MinWidth="100" ToolTip="Faixa de áudio" DisplayMemberPath="Name" SelectionChanged="Audio_Changed" Margin="0,0,8,0"/><ComboBox x:Name="SubtitleTracks" Width="140" MinWidth="100" ToolTip="Faixa de legenda" DisplayMemberPath="Name" SelectionChanged="Subtitle_Changed"/></StackPanel>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>
